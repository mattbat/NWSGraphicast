# Copied to ~/graphicast/graphicast.env by install.sh. Keep this file private (chmod 600).
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_TO=you@gmail.com
# Local state file (replaces the git "state" branch used on GitHub Actions).
GRAPHICAST_STATE=$HOME/graphicast/state.json
# Images are embedded in the email (no image hosting). Leave GRAPHICAST_IMAGES_DIR unset.
